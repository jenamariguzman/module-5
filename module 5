class Student {
    constructor(score) {
        this.score = score;
    }

    get score() {
        return this._score;
    }

    set score(value) {
        if (value < 0) {
            console.log("no negative scores");
        } else {
            this._score = value;
        }
    }
}

const ana = new Student(90);
ana.score = -5;
console.log(ana.score);

class Product {
    constructor(name, price) {
        this.name = name;
        this.price = price;
    }

    get price() {
        return this._price;
    }

    set price(value) {
        if (value < 0) {
            console.log("no negative prices");
        } else {
            this._price = value;
        }
    }
}

const pen = new Product("Pen", 25);
pen.price = -10;
console.log(pen.price);


